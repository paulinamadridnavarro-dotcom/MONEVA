// Configuración de Cloudflare Workers: sirve la app estática desde esta carpeta.
// Todas las peticiones pasan primero por worker.js, que exige haber iniciado sesión
// (cuentas con correo y contraseña en la base D1 "moneva-usuarios").
{
  "name": "moneva",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "moneva-usuarios", "database_id": "44c80ffa-4e47-4708-b476-d0b4f9bc50c5" }
  ],
  // Necesario para que Workers Builds publique las vistas previas de cada PR (npx wrangler preview).
  // Las vistas previas usan su propia base de cuentas para no tocar las de producción.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "moneva-usuarios-preview", "database_id": "b4b4e3f1-5d7a-49f1-b72d-0b02c17e1486" }
    ]
  }
}
